<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted preferences because Keystore keys don't transfer between devices -->
        <exclude domain="sharedpref" path="upi_secure_prefs.xml"/>
        <!-- Exclude recordings to save space and maintain privacy -->
        <exclude domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- For direct device-to-device transfer, we can include settings but still skip recordings if they are large -->
        <exclude domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>